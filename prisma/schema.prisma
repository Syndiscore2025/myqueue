// MyQueue Prisma schema.
//
// Phase 2 introduces the multi-tenant Slack installation platform. Every tenant
// is a Slack workspace; all tenant-owned rows reference a Workspace and are
// removed via cascade when a workspace is deleted. Slack tokens are NEVER stored
// in plaintext — only AES-256-GCM ciphertext columns are persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lifecycle state of a tenant workspace.
enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  UNINSTALLED
}

/// Auditable platform actions recorded per workspace.
enum AuditAction {
  APP_INSTALLED
  APP_REINSTALLED
  APP_UNINSTALLED
  TOKENS_REVOKED
  SETTINGS_UPDATED
  PLAN_CHANGED
}

/// The subscription tier a workspace is on. FREE is the default for every new
/// installation; PRO and BUSINESS are purchased via the billing provider.
enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
}

/// Billing status of a workspace's subscription. ACTIVE grants paid
/// entitlements; PAST_DUE retains access during dunning; CANCELED falls back to
/// Free-tier limits. Mirrors the domain `WorkspacePlanStatus`.
enum WorkspacePlanStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

/// A tenant: one Slack workspace (or enterprise-grid org) installation.
model Workspace {
  id                  String          @id @default(cuid())
  slackTeamId         String?         @unique @map("slack_team_id")
  slackTeamName       String?         @map("slack_team_name")
  slackEnterpriseId   String?         @unique @map("slack_enterprise_id")
  slackEnterpriseName String?         @map("slack_enterprise_name")
  isEnterpriseInstall Boolean         @default(false) @map("is_enterprise_install")
  status              WorkspaceStatus @default(ACTIVE)
  installedAt         DateTime        @default(now()) @map("installed_at")
  uninstalledAt       DateTime?       @map("uninstalled_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Phase 6 — billing. Plan defaults to FREE for every install; the Stripe
  // identifiers are populated once a workspace starts a paid subscription. These
  // columns are null/FREE for every existing row, so behavior is unchanged until
  // an admin upgrades.
  plan                 WorkspacePlan       @default(FREE)
  planStatus           WorkspacePlanStatus @default(ACTIVE) @map("plan_status")
  stripeCustomerId     String?             @unique @map("stripe_customer_id")
  stripeSubscriptionId String?             @unique @map("stripe_subscription_id")
  planUpdatedAt        DateTime?           @map("plan_updated_at")

  installation SlackInstallation?
  settings     WorkspaceSettings?
  users        WorkspaceUser[]
  auditLogs    WorkspaceAuditLog[]

  queueItems          QueueItem[]
  queueEvents         QueueEvent[]
  queueSettings       WorkspaceQueueSettings?
  workerRegistrations WorkerRegistration[]

  @@map("workspaces")
}

/// Encrypted Slack OAuth installation for a workspace. Tokens are stored only as
/// AES-256-GCM ciphertext; structured, non-sensitive metadata is kept in columns
/// so an Installation can be faithfully reconstructed for the Bolt SDK.
model SlackInstallation {
  id                  String  @id @default(cuid())
  workspaceId         String  @unique @map("workspace_id")
  appId               String? @map("app_id")
  authVersion         String  @default("v2") @map("auth_version")
  tokenType           String? @map("token_type")
  isEnterpriseInstall Boolean @default(false) @map("is_enterprise_install")
  enterpriseUrl       String? @map("enterprise_url")

  botId                     String?   @map("bot_id")
  botUserId                 String?   @map("bot_user_id")
  botScopes                 String[]  @map("bot_scopes")
  botTokenCiphertext        String?   @map("bot_token_ciphertext")
  botRefreshTokenCiphertext String?   @map("bot_refresh_token_ciphertext")
  botTokenExpiresAt         DateTime? @map("bot_token_expires_at")

  installerUserId            String?   @map("installer_user_id")
  userScopes                 String[]  @map("user_scopes")
  userTokenCiphertext        String?   @map("user_token_ciphertext")
  userRefreshTokenCiphertext String?   @map("user_refresh_token_ciphertext")
  userTokenExpiresAt         DateTime? @map("user_token_expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  revokedAt DateTime? @map("revoked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("slack_installations")
}

/// Per-workspace configuration.
model WorkspaceSettings {
  id               String   @id @default(cuid())
  workspaceId      String   @unique @map("workspace_id")
  timezone         String   @default("UTC")
  locale           String   @default("en-US")
  defaultChannelId String?  @map("default_channel_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

/// A Slack user known within a workspace (installer/admins recorded at install).
model WorkspaceUser {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  slackUserId String   @map("slack_user_id")
  displayName String?  @map("display_name")
  isAdmin     Boolean  @default(false) @map("is_admin")
  isInstaller Boolean  @default(false) @map("is_installer")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slackUserId])
  @@index([workspaceId])
  @@map("workspace_users")
}

/// Short-lived, single-use OAuth state values for CSRF protection during the
/// install flow. The signed install options are persisted as JSON.
model OAuthState {
  id         String    @id @default(cuid())
  state      String    @unique
  payload    Json
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

/// Append-only audit trail of platform actions, scoped per workspace.
model WorkspaceAuditLog {
  id               String      @id @default(cuid())
  workspaceId      String      @map("workspace_id")
  action           AuditAction
  actorSlackUserId String?     @map("actor_slack_user_id")
  metadata         Json?
  createdAt        DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("workspace_audit_logs")
}

// ============================================================================
// Phase 3A — Queue domain
//
// The core MyQueue engine. Every queue row is tenant-scoped by workspaceId and
// owned by a WorkspaceUser (referenced by id; actor/owner ids are plain columns
// following the Phase 2 audit-log precedent). Each item carries a PERMANENT,
// per-workspace identifier (e.g. MQ-000842) that never changes; the visible
// "#position" is computed dynamically by the ranking engine and is never stored
// as identity.
// ============================================================================

/// Lifecycle state of a queue item. Exact set defined by the product spec.
///
/// Phase 3B adds two processing states (additive — Phase 3A states are
/// unchanged): `Processing` for an item currently claimed by a worker, and
/// `DeadLetter` for an item that exhausted its retry budget.
enum QueueStatus {
  New
  Working
  Waiting
  FollowUp
  Snoozed
  Done
  Archived
  Processing
  DeadLetter
}

/// Urgency of a queue item. Red = urgent, Yellow = needs attention, Green = low.
enum QueuePriority {
  Red
  Yellow
  Green
}

/// How an owner's active queue is ordered.
enum QueueRankingMode {
  FIFO
  PRIORITY
}

/// Origin of a queue item. Slack sources are wired in later phases; the columns
/// exist now so items can be created from any source without a schema change.
enum QueueSourceType {
  SLACK_MESSAGE
  SLACK_COMMAND
  MANUAL
  API
}

/// Auditable queue actions recorded in the append-only QueueEvent log.
///
/// Phase 3B adds processing-lifecycle actions (additive): a worker claiming an
/// item, releasing it, automatic recovery of an expired lock, a processing
/// failure, a scheduled retry, dead-lettering, and requeueing from the DLQ.
///
/// Phase 3C adds scheduling/orchestration actions (additive): delay, schedule,
/// activation, recurrence rule lifecycle, rate-limit, and dependency events.
enum QueueEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  PRIORITY_CHANGED
  STATUS_CHANGED
  MOVED_TO_WAITING
  MOVED_TO_FOLLOW_UP
  SNOOZED
  UNSNOOZED
  COMPLETED
  ARCHIVED
  RECALCULATED
  CLAIMED
  RELEASED
  RECOVERED
  FAILED
  RETRY_SCHEDULED
  DEAD_LETTERED
  REQUEUED
  // Phase 3C — scheduling & orchestration
  DELAYED
  SCHEDULED
  ACTIVATED
  RECURRENCE_CREATED
  RECURRENCE_PAUSED
  RECURRENCE_RESUMED
  RECURRENCE_DISABLED
  RECURRING_ITEM_CREATED
  RATE_LIMITED
  DEPENDENCY_BLOCKED
  DEPENDENCY_UNBLOCKED
  // Phase 5 — automation & notifications
  NOTIFIED
}

/// Liveness of a registered worker process within a workspace. `ACTIVE` workers
/// have a recent heartbeat; `IDLE` workers are registered but holding no items;
/// `DEAD` workers missed their heartbeat window and are eligible for recovery.
enum WorkerStatus {
  ACTIVE
  IDLE
  DEAD
}

/// Why a scheduled/delayed/snoozed item was moved back to claimable state.
/// Recorded in QueueItem.activationReason and the ACTIVATED audit event.
enum QueueActivationReason {
  SCHEDULED
  DELAYED
  SNOOZED
  DEPENDENCY_RESOLVED
  RATE_LIMIT_CLEARED
  MANUAL
}

/// How a dependent item reacts when its dependency reaches the Dead Letter Queue.
enum QueueDependencyType {
  COMPLETE_REQUIRED
  FAIL_IF_DEPENDENCY_FAILS
  CONTINUE_IF_DEPENDENCY_FAILS
}

/// Per-workspace queue configuration plus the monotonic counter used to mint
/// permanent queue ids. lastQueueSeq is incremented atomically when an item is
/// created so ids are unique and gap-deterministic per workspace.
model WorkspaceQueueSettings {
  id                     String           @id @default(cuid())
  workspaceId            String           @unique @map("workspace_id")
  rankingMode            QueueRankingMode @default(FIFO) @map("ranking_mode")
  includeWaitingInActive Boolean          @default(false) @map("include_waiting_in_active")
  includeWorkingInActive Boolean          @default(true) @map("include_working_in_active")
  lastQueueSeq           Int              @default(0) @map("last_queue_seq")

  // Phase 5 — per-workspace notification preferences. Event DMs default on; the
  // daily digest is opt-in and fires at dailyDigestHourUtc (0–23, UTC).
  notifyOnAssignment  Boolean @default(true) @map("notify_on_assignment")
  notifyOnSnoozeWake  Boolean @default(true) @map("notify_on_snooze_wake")
  notifyOnFollowUpDue Boolean @default(true) @map("notify_on_follow_up_due")
  dailyDigestEnabled  Boolean @default(false) @map("daily_digest_enabled")
  dailyDigestHourUtc  Int     @default(13) @map("daily_digest_hour_utc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_queue_settings")
}

/// A single tracked work item in a user's queue.
model QueueItem {
  id                     String          @id @default(cuid())
  workspaceId            String          @map("workspace_id")
  permanentQueueId       String          @map("permanent_queue_id")
  ownerWorkspaceUserId   String          @map("owner_workspace_user_id")
  creatorWorkspaceUserId String?         @map("creator_workspace_user_id")
  sourceType             QueueSourceType @default(MANUAL) @map("source_type")
  sourceSlackChannelId   String?         @map("source_slack_channel_id")
  sourceSlackUserId      String?         @map("source_slack_user_id")
  sourceSlackMessageTs   String?         @map("source_slack_message_ts")
  sourceSlackThreadTs    String?         @map("source_slack_thread_ts")
  sourceSlackPermalink   String?         @map("source_slack_permalink")
  title                  String
  summary                String?
  status                 QueueStatus     @default(New)
  priority               QueuePriority   @default(Green)
  rankingTimestamp       DateTime        @default(now()) @map("ranking_timestamp")
  snoozedUntil           DateTime?       @map("snoozed_until")
  followUpDueAt          DateTime?       @map("follow_up_due_at")
  assignedAt             DateTime?       @map("assigned_at")
  completedAt            DateTime?       @map("completed_at")
  archivedAt             DateTime?       @map("archived_at")

  // Phase 3B — worker locking, processing lifecycle, retry, and dead-letter.
  // These columns are null/zero for every Phase 3A item and only populated once
  // a worker claims an item, so existing behavior is unchanged.
  claimedByWorkerId     String?   @map("claimed_by_worker_id")
  claimedAt             DateTime? @map("claimed_at")
  heartbeatAt           DateTime? @map("heartbeat_at")
  lockExpiresAt         DateTime? @map("lock_expires_at")
  attemptCount          Int       @default(0) @map("attempt_count")
  processingStartedAt   DateTime? @map("processing_started_at")
  processingCompletedAt DateTime? @map("processing_completed_at")
  lastError             String?   @map("last_error")
  lastErrorStack        String?   @map("last_error_stack")
  failedAt              DateTime? @map("failed_at")
  deadLetteredAt        DateTime? @map("dead_lettered_at")

  // Phase 3C — scheduling, orchestration, and partitioning.
  // Single claim gate: a null value means "available immediately"; a future
  // timestamp means the item is invisible to workers until that time passes.
  // scheduledFor and delayUntil are human-readable source fields that feed into
  // availableAt at creation / delay time.
  availableAt           DateTime?              @map("available_at")
  scheduledFor          DateTime?              @map("scheduled_for")
  delayUntil            DateTime?              @map("delay_until")
  blockedUntil          DateTime?              @map("blocked_until")
  activationReason      QueueActivationReason? @map("activation_reason")
  recurrenceRuleId      String?                @map("recurrence_rule_id")
  parentRecurringItemId String?                @map("parent_recurring_item_id")
  rateLimitKey          String?                @map("rate_limit_key")
  partitionKey          String?                @map("partition_key")
  dependencyGroupId     String?                @map("dependency_group_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statusHistory   QueueStatusHistory[]
  priorityHistory QueuePriorityHistory[]
  assignments     QueueAssignment[]
  events          QueueEvent[]
  positions       QueuePositionSnapshot[]
  recurrenceRule  QueueRecurrenceRule?    @relation(fields: [recurrenceRuleId], references: [id])
  dependenciesOn  QueueDependency[]       @relation("DependentItem")
  dependenciesOf  QueueDependency[]       @relation("DependencyItem")

  @@unique([workspaceId, permanentQueueId])
  @@index([workspaceId, ownerWorkspaceUserId, status])
  @@index([workspaceId, ownerWorkspaceUserId, priority, rankingTimestamp])
  // Workspace-wide claim selection (status = New, ranked) and expired-lock
  // recovery (status = Processing, lock_expires_at < now()).
  @@index([workspaceId, status, priority, rankingTimestamp])
  @@index([workspaceId, status, lockExpiresAt])
  // Phase 3C — scheduler sweep indexes.
  @@index([workspaceId, availableAt])
  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, delayUntil])
  @@index([workspaceId, partitionKey, status, priority, rankingTimestamp])
  @@index([workspaceId, rateLimitKey])
  @@index([workspaceId, dependencyGroupId])
  @@index([recurrenceRuleId])
  @@map("queue_items")
}

/// Append-only history of status transitions for a queue item.
model QueueStatusHistory {
  id                   String       @id @default(cuid())
  workspaceId          String       @map("workspace_id")
  queueItemId          String       @map("queue_item_id")
  fromStatus           QueueStatus? @map("from_status")
  toStatus             QueueStatus  @map("to_status")
  actorWorkspaceUserId String?      @map("actor_workspace_user_id")
  createdAt            DateTime     @default(now()) @map("created_at")

  queueItem QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, queueItemId, createdAt])
  @@map("queue_status_history")
}

/// Append-only history of priority changes (automatic or manual) for an item.
model QueuePriorityHistory {
  id                   String         @id @default(cuid())
  workspaceId          String         @map("workspace_id")
  queueItemId          String         @map("queue_item_id")
  fromPriority         QueuePriority? @map("from_priority")
  toPriority           QueuePriority  @map("to_priority")
  source               String
  reason               String?
  automatic            Boolean        @default(false)
  actorWorkspaceUserId String?        @map("actor_workspace_user_id")
  createdAt            DateTime       @default(now()) @map("created_at")

  queueItem QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, queueItemId, createdAt])
  @@map("queue_priority_history")
}

/// Append-only history of ownership assignments for a queue item.
model QueueAssignment {
  id                           String   @id @default(cuid())
  workspaceId                  String   @map("workspace_id")
  queueItemId                  String   @map("queue_item_id")
  previousOwnerWorkspaceUserId String?  @map("previous_owner_workspace_user_id")
  ownerWorkspaceUserId         String   @map("owner_workspace_user_id")
  assignedByWorkspaceUserId    String?  @map("assigned_by_workspace_user_id")
  createdAt                    DateTime @default(now()) @map("created_at")

  queueItem QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, queueItemId, createdAt])
  @@map("queue_assignments")
}

/// Append-only audit trail of queue events, scoped per workspace. queueItemId is
/// nullable so queue-wide events (e.g. RECALCULATED) can be recorded.
model QueueEvent {
  id                   String         @id @default(cuid())
  workspaceId          String         @map("workspace_id")
  queueItemId          String?        @map("queue_item_id")
  actorWorkspaceUserId String?        @map("actor_workspace_user_id")
  eventType            QueueEventType @map("event_type")
  previousValue        String?        @map("previous_value")
  newValue             String?        @map("new_value")
  metadata             Json?
  createdAt            DateTime       @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  queueItem QueueItem? @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, queueItemId, createdAt])
  @@map("queue_events")
}

/// Snapshot of an owner's computed queue positions at a point in time. Captured
/// on recalculation so dynamic positions can be audited/diffed historically.
model QueuePositionSnapshot {
  id                   String           @id @default(cuid())
  workspaceId          String           @map("workspace_id")
  ownerWorkspaceUserId String           @map("owner_workspace_user_id")
  queueItemId          String           @map("queue_item_id")
  position             Int
  rankingMode          QueueRankingMode @map("ranking_mode")
  createdAt            DateTime         @default(now()) @map("created_at")

  queueItem QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ownerWorkspaceUserId, createdAt])
  @@map("queue_position_snapshots")
}

// ============================================================================
// Phase 3B — Worker infrastructure
//
// A worker is an external process that claims and executes queue items. Workers
// are tenant-scoped: a worker id is unique per workspace and every registry
// query is scoped by workspaceId. Workers auto-register on first heartbeat or
// claim; processingCount tracks the items they currently hold.
// ============================================================================

/// A registered worker process within a workspace.
model WorkerRegistration {
  id              String       @id @default(cuid())
  workspaceId     String       @map("workspace_id")
  workerId        String       @map("worker_id")
  hostname        String?
  status          WorkerStatus @default(ACTIVE)
  processingCount Int          @default(0) @map("processing_count")
  startedAt       DateTime     @default(now()) @map("started_at")
  lastSeenAt      DateTime     @default(now()) @map("last_seen_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, workerId])
  @@index([workspaceId, status])
  @@map("worker_registrations")
}

// ============================================================================
// Phase 3C — Scheduling, recurrence, rate-limiting, and dependencies
//
// These tables are additive; all Phase 3A/3B behavior is unchanged. New columns
// on QueueItem are nullable and default to null for every existing row.
// ============================================================================

/// A recurring cron rule that generates new QueueItems on a schedule.
/// Scheduler checks enabled rules; when next_run_at <= now() it spawns a child
/// QueueItem and advances next_run_at using the cron expression + timezone.
model QueueRecurrenceRule {
  id                       String        @id @default(cuid())
  workspaceId              String        @map("workspace_id")
  /// User who created this rule (audit trail).
  createdByWorkspaceUserId String?       @map("created_by_workspace_user_id")
  /// User who will own the QueueItems spawned by this rule. Defaults to creator.
  ownerWorkspaceUserId     String?       @map("owner_workspace_user_id")
  name                     String
  cronExpression           String        @map("cron_expression")
  timezone                 String        @default("UTC")
  isEnabled                Boolean       @default(true) @map("is_enabled")
  nextRunAt                DateTime?     @map("next_run_at")
  lastRunAt                DateTime?     @map("last_run_at")
  maxRuns                  Int?          @map("max_runs")
  runCount                 Int           @default(0) @map("run_count")
  payloadTemplate          Json?         @map("payload_template")
  priority                 QueuePriority @default(Green)
  partitionKey             String?       @map("partition_key")
  rateLimitKey             String?       @map("rate_limit_key")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  items QueueItem[]

  @@index([workspaceId, isEnabled, nextRunAt])
  @@index([workspaceId])
  @@map("queue_recurrence_rules")
}

/// Dependency edge: a queue item that cannot be claimed until another completes.
/// dependencyType determines the reaction when the upstream item is dead-lettered.
model QueueDependency {
  id                   String              @id @default(cuid())
  workspaceId          String              @map("workspace_id")
  queueItemId          String              @map("queue_item_id")
  dependsOnQueueItemId String              @map("depends_on_queue_item_id")
  dependencyType       QueueDependencyType @default(COMPLETE_REQUIRED) @map("dependency_type")
  createdAt            DateTime            @default(now()) @map("created_at")

  queueItem     QueueItem @relation("DependentItem", fields: [queueItemId], references: [id], onDelete: Cascade)
  dependsOnItem QueueItem @relation("DependencyItem", fields: [dependsOnQueueItemId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, dependsOnQueueItemId])
  @@index([workspaceId, queueItemId])
  @@index([workspaceId, dependsOnQueueItemId])
  @@map("queue_dependencies")
}

/// Sliding-window rate-limit bucket keyed by workspace + rateLimitKey.
/// currentCount is reset lazily when now() > windowStartedAt + windowSeconds.
model QueueRateLimitBucket {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  rateLimitKey    String   @map("rate_limit_key")
  windowSeconds   Int      @map("window_seconds")
  maxItems        Int      @map("max_items")
  currentCount    Int      @default(0) @map("current_count")
  windowStartedAt DateTime @default(now()) @map("window_started_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, rateLimitKey])
  @@index([workspaceId, rateLimitKey])
  @@map("queue_rate_limit_buckets")
}
